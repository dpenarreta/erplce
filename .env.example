# Variables del entorno Docker Compose (proyecto "erp").
# Uso: cp .env.example .env   (.env NO se versiona) y completa los valores vacíos.
# Si falta alguna variable obligatoria, `docker compose` falla indicando cuál.

# Usuario y contraseña de PostgreSQL (los usa también Odoo para conectarse).
# El usuario no puede ser "postgres" (Odoo se niega a conectar como superusuario por defecto).
POSTGRES_USER=odoo
# Obligatorio. Genera una propia, p. ej.: openssl rand -base64 24
POSTGRES_PASSWORD=

# Puerto local (solo 127.0.0.1) donde se publica Odoo. Opcional, por defecto 8069.
ODOO_HTTP_PORT=8069

# Opcional. CA adicional (.pem) si un proxy/antivirus inspecciona TLS (p. ej.
# Kaspersky). La usa scripts/check.sh para descargar hooks; no desactiva TLS.
# Ejemplo Windows: ERP_EXTRA_CA_CERT=C:/Users/<usuario>/kaspersky-ca.pem
ERP_EXTRA_CA_CERT=
