<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
  <!--
        Número de la liquidación de haberes (US-013): LIQ/AAAA/NNNN, con
        numeración que reinicia cada año (rango por fecha). Común a todas las
        empresas; la capa de negocio lo asigna con
        ir.sequence.next_by_code("erp.hr.settlement").
    -->
  <record id="seq_erp_hr_settlement" model="ir.sequence">
    <field name="name">Liquidación de haberes</field>
    <field name="code">erp.hr.settlement</field>
    <field name="prefix">LIQ/%(range_year)s/</field>
    <field name="padding">4</field>
    <field name="use_date_range" eval="True" />
    <field name="company_id" eval="False" />
  </record>
</odoo>
