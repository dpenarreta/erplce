<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
  <!--
        Tipos de ausencia de Ecuador (US-012, CA-2). Configuración de partida
        «a validar» por Talento Humano; noupdate: las actualizaciones del
        módulo no pisan sus cambios. Comunes a todas las empresas
        (company_id vacío), como los tipos nativos.

        Aprobación (leave_validation_type):
        - «manager» (jefe del empleado = Jefe inmediato): vacaciones,
          enfermedad, calamidad doméstica, lactancia y permiso con sueldo.
        - «both» (jefe y después responsable de ausencias de RRHH): maternidad
          y paternidad (RRHH comprueba el supuesto legal y el certificado,
          que determinan la duración y el subsidio del IESS) y permiso sin
          sueldo (afecta al rol de pagos).
        Pagado: campo nativo «unpaid» (solo el permiso sin sueldo es no
        pagado). Las duraciones máximas son códigos de parámetros de nómina
        (data/erp_payroll_parameter_data.xml), nunca números.
        Colores: índices de la paleta de Odoo sin rojo ni naranja (se
        reservan para avisos).
    -->
  <record id="leave_type_annual_vacation" model="hr.leave.type">
    <field name="name">Vacaciones anuales</field>
    <field name="sequence">10</field>
    <field name="erp_is_annual_vacation" eval="True" />
    <field name="requires_allocation">yes</field>
    <field name="employee_requests">no</field>
    <field name="allocation_validation_type">hr</field>
    <field name="leave_validation_type">manager</field>
    <!-- Medios días: los periodos de jornada parcial tienen medios días. -->
    <field name="request_unit">half_day</field>
    <field name="unpaid" eval="False" />
    <field name="support_document" eval="False" />
    <field name="icon_id" ref="hr_holidays.icon_14" />
    <field name="color">10</field>
    <field name="company_id" eval="False" />
  </record>
  <record id="leave_type_sick" model="hr.leave.type">
    <field name="name">Enfermedad</field>
    <field name="sequence">20</field>
    <field name="requires_allocation">no</field>
    <field name="leave_validation_type">manager</field>
    <field name="request_unit">day</field>
    <field name="unpaid" eval="False" />
    <field name="support_document" eval="True" />
    <field name="erp_attachment_required" eval="True" />
    <field name="leave_notif_subtype_id" ref="hr_holidays.mt_leave_sick" />
    <field name="icon_id" ref="hr_holidays.icon_22" />
    <field name="color">4</field>
    <field name="company_id" eval="False" />
  </record>
  <record id="leave_type_maternity" model="hr.leave.type">
    <field name="name">Licencia por maternidad</field>
    <field name="sequence">30</field>
    <field name="requires_allocation">no</field>
    <field name="leave_validation_type">both</field>
    <field name="request_unit">day</field>
    <field name="unpaid" eval="False" />
    <field name="support_document" eval="True" />
    <field name="erp_attachment_required" eval="True" />
    <field name="erp_max_duration_param_code">LEAVE_MATERNITY_MAX_DAYS</field>
    <field name="icon_id" ref="hr_holidays.icon_11" />
    <field name="color">11</field>
    <field name="company_id" eval="False" />
  </record>
  <record id="leave_type_paternity" model="hr.leave.type">
    <field name="name">Licencia por paternidad</field>
    <field name="sequence">40</field>
    <field name="requires_allocation">no</field>
    <field name="leave_validation_type">both</field>
    <field name="request_unit">day</field>
    <field name="unpaid" eval="False" />
    <field name="support_document" eval="True" />
    <field name="erp_attachment_required" eval="True" />
    <field name="erp_max_duration_param_code">LEAVE_PATERNITY_MAX_DAYS</field>
    <field name="icon_id" ref="hr_holidays.icon_17" />
    <field name="color">7</field>
    <field name="company_id" eval="False" />
  </record>
  <record id="leave_type_calamity" model="hr.leave.type">
    <field name="name">Calamidad doméstica</field>
    <field name="sequence">50</field>
    <field name="requires_allocation">no</field>
    <field name="leave_validation_type">manager</field>
    <field name="request_unit">day</field>
    <field name="unpaid" eval="False" />
    <field name="support_document" eval="True" />
    <field name="erp_attachment_required" eval="True" />
    <field name="erp_max_duration_param_code">LEAVE_CALAMITY_MAX_DAYS</field>
    <field name="color">6</field>
    <field name="company_id" eval="False" />
  </record>
  <record id="leave_type_nursing" model="hr.leave.type">
    <field name="name">Lactancia</field>
    <field name="sequence">60</field>
    <field name="requires_allocation">no</field>
    <field name="leave_validation_type">manager</field>
    <field name="request_unit">hour</field>
    <field name="unpaid" eval="False" />
    <field name="support_document" eval="True" />
    <field name="erp_attachment_required" eval="False" />
    <field name="erp_max_duration_param_code">LEAVE_NURSING_HOURS_PER_DAY</field>
    <field name="color">3</field>
    <field name="company_id" eval="False" />
  </record>
  <record id="leave_type_paid_permission" model="hr.leave.type">
    <field name="name">Permiso con sueldo</field>
    <field name="sequence">70</field>
    <field name="requires_allocation">no</field>
    <field name="leave_validation_type">manager</field>
    <field name="request_unit">hour</field>
    <field name="unpaid" eval="False" />
    <field name="support_document" eval="True" />
    <field name="erp_attachment_required" eval="False" />
    <field name="color">8</field>
    <field name="company_id" eval="False" />
  </record>
  <record id="leave_type_unpaid_permission" model="hr.leave.type">
    <field name="name">Permiso sin sueldo</field>
    <field name="sequence">80</field>
    <field name="requires_allocation">no</field>
    <field name="leave_validation_type">both</field>
    <field name="request_unit">hour</field>
    <field name="unpaid" eval="True" />
    <field name="support_document" eval="True" />
    <field name="erp_attachment_required" eval="False" />
    <field name="leave_notif_subtype_id" ref="hr_holidays.mt_leave_unpaid" />
    <field name="icon_id" ref="hr_holidays.icon_28" />
    <field name="color">5</field>
    <field name="company_id" eval="False" />
  </record>

  <!--
        Tipos genéricos que crea hr_holidays como datos (no son demo): «Paid
        Time Off», «Sick Time Off», «Compensatory Days» y «Unpaid». Se
        ARCHIVAN una sola vez al instalar (función en bloque noupdate: no se
        repite al actualizar), para que no estorben ni dupliquen los tipos de
        Ecuador. No se borran: hr_holidays y otros módulos los referencian por
        xmlid y los actualiza en cada actualización de hr_holidays (que no toca
        «active»). Talento Humano puede reactivarlos si los necesita.
    -->
  <function model="hr.leave.type" name="write">
    <value
      eval="[ref('hr_holidays.holiday_status_cl'), ref('hr_holidays.holiday_status_sl'), ref('hr_holidays.holiday_status_comp'), ref('hr_holidays.holiday_status_unpaid')]"
    />
    <value eval="{'active': False}" />
  </function>
</odoo>
