#. module: erp_hr_holidays_ec
#: model:ir.actions.act_window,help:hr_holidays.hr_leave_action_new_request
msgid ""
"<p class=\"o_view_nocontent_smiling_face\">Aún no tiene ausencias "
"registradas</p>\n"
"<p>Pulse <strong>Nuevo</strong> para pedir vacaciones o un permiso. Su jefe "
"inmediato recibirá la solicitud para aprobarla.</p>"
msgstr ""
"<p class=\"o_view_nocontent_smiling_face\">Aún no tiene ausencias "
"registradas</p>\n"
"<p>Pulse <strong>Nuevo</strong> para pedir vacaciones o un permiso. Su jefe "
"inmediato recibirá la solicitud para aprobarla.</p>"

#. module: erp_hr_holidays_ec
#: model:ir.actions.act_window,help:hr_holidays.hr_leave_action_my
msgid ""
"<p class=\"o_view_nocontent_smiling_face\">Aún no ha solicitado "
"ausencias</p>\n"
"<p>Pulse <strong>Nuevo</strong> para pedir vacaciones o un permiso. Aquí "
"verá si su jefe inmediato ya la aprobó.</p>"
msgstr ""
"<p class=\"o_view_nocontent_smiling_face\">Aún no ha solicitado "
"ausencias</p>\n"
"<p>Pulse <strong>Nuevo</strong> para pedir vacaciones o un permiso. Aquí "
"verá si su jefe inmediato ya la aprobó.</p>"

#. module: erp_hr_holidays_ec
#: model:ir.actions.act_window,help:hr_holidays.hr_leave_action_action_approve_department
msgid ""
"<p class=\"o_view_nocontent_smiling_face\">No hay ausencias por aprobar</p>\n"
"<p>Aquí aparecen las solicitudes de su equipo que esperan su aprobación. "
"Para ver también las ya aprobadas, quite el filtro <strong>Esperando mi "
"aprobación</strong>.</p>"
msgstr ""
"<p class=\"o_view_nocontent_smiling_face\">No hay ausencias por aprobar</p>\n"
"<p>Aquí aparecen las solicitudes de su equipo que esperan su aprobación. "
"Para ver también las ya aprobadas, quite el filtro <strong>Esperando mi "
"aprobación</strong>.</p>"

#. module: erp_hr_holidays_ec
#: model:ir.actions.act_window,help:hr_holidays.hr_leave_action_holiday_allocation_id
msgid ""
"<p class=\"o_view_nocontent_smiling_face\">No hay ausencias con este "
"saldo</p>\n"
"<p>Aquí aparecen las solicitudes que descuentan días de este saldo.</p>"
msgstr ""
"<p class=\"o_view_nocontent_smiling_face\">No hay ausencias con este "
"saldo</p>\n"
"<p>Aquí aparecen las solicitudes que descuentan días de este saldo.</p>"

#. module: erp_hr_holidays_ec
#: model:ir.actions.act_window,help:hr_holidays.hr_leave_allocation_action_my
msgid ""
"<p class=\"o_view_nocontent_smiling_face\">Aún no tiene saldo de "
"vacaciones</p>\n"
"<p>Talento Humano asigna sus días de vacaciones en cada aniversario de su "
"ingreso, según su antigüedad. Si falta su saldo, consulte a Talento "
"Humano.</p>"
msgstr ""
"<p class=\"o_view_nocontent_smiling_face\">Aún no tiene saldo de "
"vacaciones</p>\n"
"<p>Talento Humano asigna sus días de vacaciones en cada aniversario de su "
"ingreso, según su antigüedad. Si falta su saldo, consulte a Talento "
"Humano.</p>"

#. module: erp_hr_holidays_ec
#: model:ir.actions.act_window,help:hr_holidays.hr_leave_allocation_action_approve_department
msgid ""
"<p class=\"o_view_nocontent_empty_folder\">Aún no hay saldos de "
"vacaciones</p>\n"
"<p>Aquí están los días de vacaciones de cada empleado; quite los filtros "
"para verlos todos. Talento Humano los calcula por antigüedad con "
"<strong>Calcular vacaciones</strong> en la ficha o la lista de "
"empleados.</p>"
msgstr ""
"<p class=\"o_view_nocontent_empty_folder\">Aún no hay saldos de "
"vacaciones</p>\n"
"<p>Aquí están los días de vacaciones de cada empleado; quite los filtros "
"para verlos todos. Talento Humano los calcula por antigüedad con "
"<strong>Calcular vacaciones</strong> en la ficha o la lista de "
"empleados.</p>"

#. module: erp_hr_holidays_ec
#: model:ir.actions.act_window,help:hr_holidays.hr_leave_allocation_action_all
msgid ""
