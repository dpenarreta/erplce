<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <!--
    US-012 (CA-6, CA-7): solicitud de ausencia. «Justificante» (término de
    España) pasa a «Documento de respaldo»; los filtros que usan los textos de
    estado vacío de «Ausencias por aprobar» se nombran igual que en el texto.
    El botón nativo «Cancelar» lo controla can_cancel (DEV-2): no se toca.
    Al crear la solicitud, una nota atenuada explica por qué puede no aparecer
    «Vacaciones anuales» (el desplegable solo ofrece tipos con saldo).
    La herencia del formulario base alcanza también a sus vistas primarias
    (responsable, ventana del calendario).
  -->
  <record id="hr_leave_view_form_inherit_erp_hr_holidays_ec" model="ir.ui.view">
    <field name="name">hr.leave.form.inherit.erp_hr_holidays_ec</field>
    <field name="model">hr.leave</field>
    <field name="inherit_id" ref="hr_holidays.hr_leave_view_form" />
    <field name="arch" type="xml">
      <xpath expr="//label[@for='supported_attachment_ids']" position="attributes">
        <attribute name="string">Documento de respaldo</attribute>
      </xpath>
      <xpath
        expr="//group[@name='col_left']/field[@name='holiday_status_id']"
        position="after"
      >
        <div
          name="erp_no_vacation_hint"
          class="text-muted small"
          role="note"
          colspan="2"
          invisible="id"
        >
          ¿No ve Vacaciones anuales? Aún no tiene saldo; consulte a Talento Humano.
        </div>
      </xpath>
    </field>
  </record>

  <record id="hr_leave_view_search_inherit_erp_hr_holidays_ec" model="ir.ui.view">
    <field name="name">hr.leave.search.inherit.erp_hr_holidays_ec</field>
    <field name="model">hr.leave</field>
    <field name="inherit_id" ref="hr_holidays.view_hr_holidays_filter" />
    <field name="arch" type="xml">
      <xpath expr="//filter[@name='waiting_for_me']" position="attributes">
        <attribute name="string">Esperando mi aprobación</attribute>
      </xpath>
      <xpath expr="//filter[@name='waiting_for_me_manager']" position="attributes">
        <attribute name="string">Esperando mi aprobación</attribute>
      </xpath>
      <xpath expr="//filter[@name='my_leaves']" position="attributes">
        <attribute name="string">Mis ausencias</attribute>
      </xpath>
    </field>
  </record>

  <!--
    Reporte «Ausencias por empleado»: «Número de días» se truncaba en el
    encabezado.
  -->
  <record id="hr_leave_view_report_list_inherit_erp_hr_holidays_ec" model="ir.ui.view">
    <field name="name">hr.leave.report.list.inherit.erp_hr_holidays_ec</field>
    <field name="model">hr.leave</field>
    <field name="inherit_id" ref="hr_holidays.view_holiday_list" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='number_of_days']" position="attributes">
        <attribute name="string">Días</attribute>
      </xpath>
    </field>
  </record>

  <!-- Reporte «Ausencias por tipo»: mismo encabezado corto. -->
  <record id="hr_leave_report_view_list_inherit_erp_hr_holidays_ec" model="ir.ui.view">
    <field name="name">hr.leave.report.tree.inherit.erp_hr_holidays_ec</field>
    <field name="model">hr.leave.report</field>
    <field name="inherit_id" ref="hr_holidays.hr_leave_report_tree" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='number_of_days']" position="attributes">
        <attribute name="string">Días</attribute>
      </xpath>
    </field>
  </record>
</odoo>
