<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <!--
    Ajustes de nómina (OCA): el ajuste payroll.allow_cancel_payslips ya está
    visible en Ajustes > Nómina; se renombra con el texto que citan los
    mensajes de error de erp_payroll_ec («Permitir anular roles») y se explica
    su efecto en Ecuador (anular revierte el asiento).
  -->
  <record id="res_config_settings_view_form_inherit_erp_payroll_ec" model="ir.ui.view">
    <field name="name">res.config.settings.form.inherit.erp_payroll_ec</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="payroll.res_config_settings_view_form" />
    <field name="arch" type="xml">
      <xpath expr="//block[@id='allow_cancel_payslips']/setting" position="attributes">
        <attribute name="string">Permitir anular roles</attribute>
        <attribute
          name="help"
        >El responsable de nómina puede anular un rol de pagos confirmado; su asiento contable se revierte (no se borra).</attribute>
      </xpath>
      <!-- US-017 (M-1): «Default Salary Structure» de OCA. -->
      <xpath expr="//block[@id='payroll_structure']/setting" position="attributes">
        <attribute name="string">Estructura salarial por defecto</attribute>
      </xpath>
    </field>
  </record>
</odoo>
